@if (Articles.Count == 0)
{
    <p class="empty">@EmptyText</p>
}
else
{
    <ul class="stories">
        @foreach (var article in Articles)
        {
            <li>
                <a class="story" href="@article.Url" target="_blank" rel="noopener">
                    <span class="text">
                        <span class="source">@article.Source · @RelativeTime.Ago(article.Published, DateTimeOffset.UtcNow)</span>
                        <span class="headline">@article.Title</span>
                        @if (ShowSummaries && article.Summary is string summary)
                        {
                            <span class="summary">@summary</span>
                        }
                    </span>
                </a>
            </li>
        }
    </ul>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<NewsArticle> Articles { get; set; } = [];

    [Parameter] public bool ShowSummaries { get; set; } = true;

    [Parameter] public string EmptyText { get; set; } = "No stories right now.";
}
