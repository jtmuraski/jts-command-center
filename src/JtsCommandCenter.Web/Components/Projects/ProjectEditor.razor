@inject IProjectService Projects

<Modal Title="@(IsNew ? "New project" : "Edit project")" OnClose="() => OnClose.InvokeAsync()" AutoFocus="false">
    <ChildContent>
        <form id="@formId" class="cc-form" @onsubmit="SaveAsync">
            @if (conflict)
            {
                <div class="cc-form-notice" role="alert">
                    <span>This project was changed on another device after you opened it.</span>
                    <button type="button" class="cc-btn cc-btn-ghost" @onclick="LoadLatestAsync">Load latest (discards your edits)</button>
                </div>
            }
            @if (errors.Count > 0)
            {
                <ul class="cc-form-errors" role="alert">
                    @foreach (var error in errors)
                    {
                        <li>@error</li>
                    }
                </ul>
            }

            <label class="cc-field">
                <span class="cc-label">Title</span>
                <input @ref="titleInput" @bind="title" @bind:event="oninput" maxlength="@ProjectMath.MaxTitleLength"
                       placeholder="e.g. Workflow update" autocomplete="off" />
            </label>

            <div class="cc-form-row">
                <fieldset class="cc-field">
                    <legend class="cc-label">Area</legend>
                    <div class="cc-segmented">
                        @foreach (var option in Enum.GetValues<WorkArea>())
                        {
                            <label>
                                <input type="radio" name="@($"{formId}-area")" checked="@(area == option)" @onchange="() => area = option" />
                                <span>@option</span>
                            </label>
                        }
                    </div>
                </fieldset>

                <fieldset class="cc-field">
                    <legend class="cc-label">Priority</legend>
                    <div class="cc-segmented">
                        @foreach (var option in Enum.GetValues<Priority>())
                        {
                            <label>
                                <input type="radio" name="@($"{formId}-priority")" checked="@(priority == option)" @onchange="() => priority = option" />
                                <span>@option</span>
                            </label>
                        }
                    </div>
                </fieldset>
            </div>

            <div class="cc-form-row">
                <label class="cc-field">
                    <span class="cc-label">Start date</span>
                    <input type="date" @bind="startDate" />
                </label>
                <label class="cc-field">
                    <span class="cc-label">Due date</span>
                    <input type="date" @bind="dueDate" />
                </label>
                @if (IsNew)
                {
                    <label class="cc-field">
                        <span class="cc-label">Column</span>
                        <select @bind="status">
                            @foreach (var option in Enum.GetValues<ProjectStatus>())
                            {
                                <option value="@option">@ProjectMath.DisplayName(option)</option>
                            }
                        </select>
                    </label>
                }
            </div>

            <div class="cc-field">
                <label class="cc-label" for="@($"{formId}-description")">Description</label>
                <MarkdownEditor Id="@($"{formId}-description")" @bind-Value="description" ProjectId="Project?.Id"
                                Placeholder="What is this project, and what does done look like?" />
            </div>
        </form>
    </ChildContent>
    <Footer>
        @if (!IsNew && OnArchive.HasDelegate)
        {
            <button type="button" class="cc-btn cc-btn-ghost" disabled="@saving" @onclick="() => OnArchive.InvokeAsync(Project!)">Archive</button>
        }
        <span class="cc-spacer"></span>
        <button type="button" class="cc-btn cc-btn-ghost" @onclick="() => OnClose.InvokeAsync()">Cancel</button>
        <button type="submit" class="cc-btn" form="@formId" disabled="@(saving || string.IsNullOrWhiteSpace(title))">
            @(IsNew ? "Create project" : "Save")
        </button>
    </Footer>
</Modal>

@code {
    /// <summary>The project to edit, or null to create one.</summary>
    [Parameter] public Project? Project { get; set; }

    /// <summary>Column and area a new project starts in (e.g. the column whose "+" was used).</summary>
    [Parameter] public ProjectStatus InitialStatus { get; set; }
    [Parameter] public WorkArea DefaultArea { get; set; }

    [Parameter] public EventCallback<Project> OnSaved { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<Project> OnArchive { get; set; }

    private readonly string formId = $"project-{Guid.NewGuid():N}";
    private ElementReference titleInput;

    private string title = "";
    private string? description;
    private WorkArea area;
    private Priority priority = Priority.Normal;
    private ProjectStatus status;
    private DateOnly? startDate;
    private DateOnly? dueDate;
    private Guid version;

    private IReadOnlyList<string> errors = [];
    private bool conflict;
    private bool saving;

    private bool IsNew => Project is null;

    protected override void OnInitialized()
    {
        if (Project is null)
        {
            area = DefaultArea;
            status = InitialStatus;
        }
        else
        {
            Load(Project);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await titleInput.FocusAsync();
        }
    }

    private void Load(Project project)
    {
        title = project.Title;
        description = project.Description;
        area = project.Area;
        priority = project.Priority;
        startDate = project.StartDate;
        dueDate = project.DueDate;
        version = project.Version;
    }

    private async Task SaveAsync()
    {
        errors = ProjectMath.Validate(title, startDate, dueDate);
        if (errors.Count > 0 || saving)
        {
            return;
        }

        saving = true;
        try
        {
            var input = new ProjectInput(title, description, area, priority, startDate, dueDate);
            var saved = Project is null
                ? await Projects.CreateProjectAsync(input, status)
                : await Projects.UpdateProjectAsync(Project.Id, version, input);
            await OnSaved.InvokeAsync(saved);
        }
        catch (ConcurrencyConflictException)
        {
            conflict = true;
        }
        catch (Exception ex) when (ex is ArgumentException or KeyNotFoundException)
        {
            errors = [ex.Message];
        }
        finally
        {
            saving = false;
        }
    }

    private async Task LoadLatestAsync()
    {
        var latest = await Projects.GetProjectAsync(Project!.Id);
        if (latest is null)
        {
            errors = ["This project no longer exists."];
            return;
        }

        Load(latest);
        conflict = false;
        errors = [];
    }
}
