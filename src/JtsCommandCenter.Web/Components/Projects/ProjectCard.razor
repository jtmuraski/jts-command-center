@{
    var progress = ProjectMath.ProgressOf(Project.Subtasks);
    var done = Project.Status == ProjectStatus.Done;
    var overdue = ProjectMath.IsOverdue(Project, Today);
    var dueToday = !done && Project.DueDate == Today;
}
<article class="project-card area-@Project.Area.ToString().ToLowerInvariant() @(done ? "is-done" : "")"
         role="button" tabindex="0" aria-label="@Project.Title" @onclick="() => OnOpen.InvokeAsync(Project)" @onkeydown="OnKeyDown">
    <div class="card-top">
        <h3 class="title">@Project.Title</h3>
        <button type="button" class="card-actions" data-no-drag title="Actions" aria-label="Actions for @Project.Title"
                @onclick="() => OnActions.InvokeAsync(Project)" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                <circle cx="5" cy="12" r="1.6" /><circle cx="12" cy="12" r="1.6" /><circle cx="19" cy="12" r="1.6" />
            </svg>
        </button>
    </div>

    <div class="meta">
        <span class="area">@Project.Area</span>
        @if (Project.Priority != Priority.Normal)
        {
            <span class="priority priority-@Project.Priority.ToString().ToLowerInvariant()">@Project.Priority priority</span>
        }
        @if (Project.DueDate is DateOnly due)
        {
            <span class="due @(overdue ? "is-overdue" : dueToday ? "is-today" : "")">
                @(overdue ? $"Overdue · {DateText.Short(due, Today)}" : dueToday ? "Due today" : $"Due {DateText.Short(due, Today)}")
            </span>
        }
    </div>

    @if (Project.Status == ProjectStatus.OnHold && Project.BlockedReason is { } reason)
    {
        <p class="reason">@reason</p>
    }

    @if (progress.Total > 0)
    {
        <div class="progress" title="@progress.Done of @progress.Total subtasks done">
            <div class="bar"><div class="fill" style="width: @(progress.Percent)%"></div></div>
            <span class="progress-text">@progress.Done/@progress.Total</span>
        </div>
    }
</article>

@code {
    [Parameter, EditorRequired] public Project Project { get; set; } = default!;
    [Parameter, EditorRequired] public DateOnly Today { get; set; }
    [Parameter] public EventCallback<Project> OnOpen { get; set; }

    /// <summary>The "..." button: move, edit, archive. Also the way to move a card without dragging.</summary>
    [Parameter] public EventCallback<Project> OnActions { get; set; }

    private Task OnKeyDown(KeyboardEventArgs e) =>
        e.Key is "Enter" or " " ? OnOpen.InvokeAsync(Project) : Task.CompletedTask;
}
