@page "/"

<PageTitle>Dashboard · Command Center</PageTitle>

<header class="page-header">
    <div>
        <h1>@Greeting</h1>
        <p class="cc-muted">Here's what's on deck today.</p>
    </div>
    <span class="sample-badge" title="The News card shows placeholder data until a news source is connected">News is sample data</span>
</header>

<div class="dashboard">
    <div class="slot slot-weather"><WeatherCard /></div>
    <div class="slot slot-todo"><TodoCard /></div>
    <div class="slot slot-projects"><ProjectsCard /></div>
    <div class="slot slot-sports"><SportsCard /></div>
    <div class="slot slot-news"><NewsCard /></div>
</div>

@code {
    private static string Greeting => DateTime.Now.Hour switch
    {
        < 12 => "Good morning",
        < 17 => "Good afternoon",
        _ => "Good evening"
    };
}
