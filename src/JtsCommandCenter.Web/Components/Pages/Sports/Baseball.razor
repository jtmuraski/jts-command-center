@page "/sports/baseball"

<PageTitle>Baseball · Command Center</PageTitle>

<LeaguePage League="mlb" PagePath="sports/baseball" Title="Baseball" Description="MLB scores, schedule, and news."
            InitialDate="Date" />

@code {
    /// <summary>Scoreboard day to open on, e.g. ?date=2026-10-23 (set by paging and by game pages' back link).</summary>
    [SupplyParameterFromQuery] public DateOnly? Date { get; set; }
}
