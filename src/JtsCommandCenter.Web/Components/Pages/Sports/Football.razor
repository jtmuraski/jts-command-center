@page "/sports/football"

<PageTitle>Football · Command Center</PageTitle>

<LeaguePage League="nfl" PagePath="sports/football" Title="Football" Description="NFL scores, schedule, and news."
            InitialSeasonType="SeasonType" InitialWeek="Week" />

@code {
    /// <summary>Scoreboard week to open on, e.g. ?type=2&amp;week=5 (set by paging and by game pages' back link).</summary>
    [SupplyParameterFromQuery(Name = "type")] public int? SeasonType { get; set; }

    [SupplyParameterFromQuery] public int? Week { get; set; }
}
