@using Microsoft.Extensions.Options
@implements IDisposable
@inject IWeatherService WeatherService
@inject IOptions<WeatherOptions> Options
@inject ILogger<WeatherCard> Logger

<DashboardCard Title="Weather">
    <HeaderContent>@Options.Value.LocationName</HeaderContent>
    <ChildContent>
        @if (report is not null)
        {
            <div class="current">
                <div>
                    <div class="temp">@report.Current.Temperature°<span class="unit">@Unit</span></div>
                    <div class="condition">@report.Current.Description</div>
                    <div class="hilo">H @report.Current.High° · L @report.Current.Low°</div>
                </div>
                <WeatherIcon Condition="report.Current.Condition" IsNight="!report.Current.IsDay" Size="84" />
            </div>

            <dl class="stats">
                <div>
                    <dt>Feels like</dt>
                    <dd>@report.Current.FeelsLike°</dd>
                </div>
                <div>
                    <dt>Wind</dt>
                    <dd>
                        @report.Current.WindDirection @report.Current.WindSpeed <small>@report.WindUnit</small>
                        <span class="sub">Gusts @report.Current.WindGust</span>
                    </dd>
                </div>
                <div>
                    <dt>Humidity</dt>
                    <dd>@report.Current.Humidity%</dd>
                </div>
                <div>
                    <dt>Precip today</dt>
                    <dd>
                        @(report.Current.PrecipitationChance is int chance ? $"{chance}%" : "–")
                        @if (FormatSnow(report.Current.Snowfall) is string snow)
                        {
                            <span class="sub">@snow @report.SnowUnit snow</span>
                        }
                    </dd>
                </div>
            </dl>

            <ul class="forecast">
                @foreach (var day in report.Forecast)
                {
                    <li title="@day.Description">
                        <span class="day">@day.Date.ToString("ddd")</span>
                        <WeatherIcon Condition="day.Condition" Size="30" />
                        <span class="high">@day.High°</span>
                        <span class="low">@day.Low°</span>
                        <span class="precip" title="Chance of precipitation">
                            @(day.PrecipitationChance is int dayChance ? $"{dayChance}%" : "–")
                        </span>
                        @if (FormatSnow(day.Snowfall) is string daySnow)
                        {
                            <span class="snow" title="Expected snowfall">@daySnow @report.SnowUnit</span>
                        }
                    </li>
                }
            </ul>

            <div class="sun">
                <span>
                    <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M4 18h16M7 18a5 5 0 0 1 10 0M12 4v5M9 7l3-3 3 3" /></svg>
                    Sunrise @report.Current.Sunrise.ToString("h:mm tt")
                </span>
                <span>
                    <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M4 18h16M7 18a5 5 0 0 1 10 0M12 4v5M9 6l3 3 3-3" /></svg>
                    Sunset @report.Current.Sunset.ToString("h:mm tt")
                </span>
            </div>

            <div class="footer">
                @if (error is not null)
                {
                    <span class="stale">Couldn't refresh · showing last update</span>
                }
                else
                {
                    <span>As of @report.ObservedAt.ToString("h:mm tt")</span>
                }
                <a href="https://open-meteo.com/" target="_blank" rel="noopener">Open-Meteo</a>
            </div>
        }
        else if (error is not null)
        {
            <div class="state">
                <p>Weather is unavailable right now.</p>
                <button class="cc-btn cc-btn-ghost" type="button" @onclick="RetryAsync" disabled="@loading">
                    @(loading ? "Retrying…" : "Try again")
                </button>
            </div>
        }
        else
        {
            <div class="state" aria-busy="true">
                <p>Loading weather…</p>
            </div>
        }
    </ChildContent>
</DashboardCard>

@code {
    private readonly CancellationTokenSource cts = new();
    private WeatherReport? report;
    private string? error;
    private bool loading;

    private string Unit => Options.Value.TemperatureUnit.StartsWith("c", StringComparison.OrdinalIgnoreCase) ? "C" : "F";

    /// <summary>Formats a snowfall amount for display, or null when there's no meaningful snow.</summary>
    private static string? FormatSnow(double amount) => amount switch
    {
        < 0.1 => null,
        < 10 => amount.ToString("0.#"),
        _ => amount.ToString("0")
    };

    protected override Task OnInitializedAsync() => LoadAsync();

    protected override void OnAfterRender(bool firstRender)
    {
        // OnAfterRender only runs once the circuit is interactive (not during prerendering),
        // so the refresh loop starts exactly once per open dashboard.
        if (firstRender)
        {
            _ = RefreshLoopAsync();
        }
    }

    private async Task RefreshLoopAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMinutes(Options.Value.RefreshMinutes));
        try
        {
            while (await timer.WaitForNextTickAsync(cts.Token))
            {
                await InvokeAsync(async () =>
                {
                    await LoadAsync();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
            // Component disposed (page closed or navigated away).
        }
    }

    private async Task RetryAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            report = await WeatherService.GetReportAsync(cts.Token);
            error = null;
        }
        catch (OperationCanceledException) when (cts.IsCancellationRequested)
        {
            // Disposed mid-request; nothing to update.
        }
        catch (Exception ex)
        {
            // Keep showing the last good report, if any, and flag it as stale.
            Logger.LogWarning(ex, "Failed to load weather");
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    public void Dispose()
    {
        cts.Cancel();
        cts.Dispose();
    }
}
